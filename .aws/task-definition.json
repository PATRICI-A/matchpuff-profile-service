{
  "family": "profile-service-task-AWS",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "512",
  "memory": "2048",
  "executionRoleArn": "arn:aws:iam::403677987798:role/ecsTaskExecutionRole",
  "containerDefinitions": [
    {
      "name": "profile-service",
      "image": "IMAGE_PLACEHOLDER",
      "essential": true,

      "portMappings": [
        {
          "containerPort": 8443,
          "hostPort": 8443,
          "protocol": "tcp"
        }
      ],

      "environment": [
        {
          "name": "SPRING_PROFILES_ACTIVE",
          "value": "prod"
        }
      ],

      "healthCheck": {
        "command": [
          "CMD-SHELL",
          "wget -qO- --no-check-certificate https://localhost:8443/actuator/health | grep UP || exit 1"
        ],
        "interval": 30,
        "timeout": 5,
        "retries": 3,
        "startPeriod": 60
      },

      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/profile-service-task-AWS",
          "awslogs-region": "us-east-1",
          "awslogs-stream-prefix": "ecs"
        }
      }
    }
  ]
}